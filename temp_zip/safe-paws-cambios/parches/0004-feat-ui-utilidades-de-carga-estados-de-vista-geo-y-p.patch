+import type { ReactNode } from 'react'
+import Button from './Button'
+import Spinner from './Spinner'
+import estilo from './EstadoVista.module.css'
+
+interface EstadoVistaProps {
+  cargando: boolean
+  error: string | null
+  /** Si es true y no hay error ni carga, se muestra el estado vacío. */
+  vacio?: boolean
+  mensajeVacio?: ReactNode
+  accionVacio?: ReactNode
+  alReintentar?: () => void
+  etiquetaCarga?: string
+  children: ReactNode
+}
+
+/** Envuelve una vista con sus estados de carga, error y vacío. */
+export default function EstadoVista({
+  cargando,
+  error,
+  vacio = false,
+  mensajeVacio = 'No hay nada por aquí todavía.',
+  accionVacio,
+  alReintentar,
+  etiquetaCarga = 'Cargando…',
+  children,
+}: EstadoVistaProps) {
+  if (cargando) {
+    return (
+      <div className={estilo.centro}>
+        <Spinner etiqueta={etiquetaCarga} />
+      </div>
+    )
+  }
+  if (error) {
+    return (
+      <div className={estilo.centro} role="alert">
+        <p className={estilo.icono} aria-hidden="true">
+          ⚠️
+        </p>
+        <p className={estilo.texto}>{error}</p>
+        {alReintentar && (
+          <Button variante="secundario" onClick={alReintentar}>
+            Reintentar
+          </Button>
+        )}
+      </div>
+    )
+  }
+  if (vacio) {
+    return (
+      <div className={estilo.centro}>
+        <p className={estilo.icono} aria-hidden="true">
+          🐾
+        </p>
+        <p className={estilo.texto}>{mensajeVacio}</p>
+        {accionVacio}
+      </div>
+    )
+  }
+  return <>{children}</>
+}
diff --git a/src/hooks/useCarga.ts b/src/hooks/useCarga.ts
new file mode 100644
index 0000000..e8911b5
--- /dev/null
+++ b/src/hooks/useCarga.ts
@@ -0,0 +1,46 @@
+import { useCallback, useEffect, useState } from 'react'
+import { mensajeError } from '@/utils/errores'
+
+export interface EstadoCarga<T> {
+  datos: T | null
+  cargando: boolean
+  error: string | null
+  recargar: () => void
+  /** Reemplaza los datos en memoria (p. ej. tras una mutación o un evento Realtime). */
+  establecer: (actualizar: (previo: T | null) => T | null) => void
+}
+
+/**
+ * Carga asíncrona con estados de carga/error y recarga manual.
+ * `cargar` debe ser estable (useCallback) o la carga se repetirá en cada render.
+ */
+export function useCarga<T>(cargar: () => Promise<T>): EstadoCarga<T> {
+  const [datos, setDatos] = useState<T | null>(null)
+  const [cargando, setCargando] = useState(true)
+  const [error, setError] = useState<string | null>(null)
+  const [version, setVersion] = useState(0)
+
+  useEffect(() => {
+    let vigente = true
+    setCargando(true)
+    setError(null)
+    cargar()
+      .then((resultado) => {
+        if (vigente) setDatos(resultado)
+      })
+      .catch((e: unknown) => {
+        if (vigente) setError(mensajeError(e))
+      })
+      .finally(() => {
+        if (vigente) setCargando(false)
+      })
+    return () => {
+      vigente = false
+    }
+  }, [cargar, version])
+
+  const recargar = useCallback(() => setVersion((v) => v + 1), [])
+  const establecer = useCallback((actualizar: (previo: T | null) => T | null) => setDatos(actualizar), [])
+
+  return { datos, cargando, error, recargar, establecer }
+}
