+++ b/src/utils/geo.ts
@@ -0,0 +1,36 @@
+export interface Coordenada {
+  latitud: number
+  longitud: number
+}
+
+const RADIO_TIERRA_KM = 6371
+
+const aRadianes = (grados: number) => (grados * Math.PI) / 180
+
+/** Distancia en km entre dos puntos (fórmula del haversine). */
+export function distanciaKm(a: Coordenada, b: Coordenada): number {
+  const dLat = aRadianes(b.latitud - a.latitud)
+  const dLng = aRadianes(b.longitud - a.longitud)
+  const h =
+    Math.sin(dLat / 2) ** 2 + Math.cos(aRadianes(a.latitud)) * Math.cos(aRadianes(b.latitud)) * Math.sin(dLng / 2) ** 2
+  return 2 * RADIO_TIERRA_KM * Math.asin(Math.min(1, Math.sqrt(h)))
+}
+
+/** Largo total de una ruta en km. */
+export function largoRutaKm(puntos: Coordenada[]): number {
+  let total = 0
+  for (let i = 1; i < puntos.length; i++) total += distanciaKm(puntos[i - 1], puntos[i])
+  return total
+}
+
+export function formatearDistancia(km: number): string {
+  return km < 1 ? `${Math.round(km * 1000)} m` : `${km.toFixed(1).replace('.', ',')} km`
+}
+
+/** Duración legible: "1 h 05 min", "12 min". */
+export function formatearDuracion(milisegundos: number): string {
+  const minutos = Math.max(0, Math.round(milisegundos / 60000))
+  const horas = Math.floor(minutos / 60)
+  const resto = minutos % 60
+  return horas > 0 ? `${horas} h ${String(resto).padStart(2, '0')} min` : `${resto} min`
+}
diff --git a/src/utils/utilidades.test.ts b/src/utils/utilidades.test.ts
new file mode 100644
index 0000000..1692bb6
--- /dev/null
+++ b/src/utils/utilidades.test.ts
@@ -0,0 +1,43 @@
+import { describe, expect, it } from 'vitest'
+import { distanciaKm, formatearDistancia, formatearDuracion, largoRutaKm } from './geo'
+import { calcularPrecio, formatearClp, unidadesCobrables } from './precios'
+
+describe('geo', () => {
+  it('calcula distancias reales en Santiago', () => {
+    const plazaDeArmas = { latitud: -33.4378, longitud: -70.6505 }
+    const costanera = { latitud: -33.4173, longitud: -70.6062 }
+    expect(distanciaKm(plazaDeArmas, costanera)).toBeCloseTo(4.67, 1)
+    expect(distanciaKm(plazaDeArmas, plazaDeArmas)).toBe(0)
+  })
+
+  it('suma el largo de una ruta', () => {
+    const a = { latitud: 0, longitud: 0 }
+    const b = { latitud: 0, longitud: 0.01 }
+    const c = { latitud: 0, longitud: 0.02 }
+    expect(largoRutaKm([a, b, c])).toBeCloseTo(distanciaKm(a, c), 6)
+    expect(largoRutaKm([a])).toBe(0)
+  })
+
+  it('formatea distancias y duraciones', () => {
+    expect(formatearDistancia(0.35)).toBe('350 m')
+    expect(formatearDistancia(2.345)).toBe('2,3 km')
+    expect(formatearDuracion(12 * 60000)).toBe('12 min')
+    expect(formatearDuracion(65 * 60000)).toBe('1 h 05 min')
+  })
+})
+
+describe('precios', () => {
+  const inicio = new Date('2026-11-01T10:00:00Z')
+  it('cobra bloques de 24 h iniciados, mínimo 1', () => {
+    expect(unidadesCobrables(inicio, new Date('2026-11-01T11:00:00Z'))).toBe(1)
+    expect(unidadesCobrables(inicio, new Date('2026-11-03T10:00:00Z'))).toBe(2)
+    expect(unidadesCobrables(inicio, new Date('2026-11-03T10:00:01Z'))).toBe(3)
+    expect(unidadesCobrables(inicio, inicio)).toBe(0)
+  })
+
+  it('calcula el total y formatea en CLP', () => {
+    expect(calcularPrecio(inicio, new Date('2026-11-03T10:00:00Z'), 25000)).toBe(50000)
+    expect(calcularPrecio(inicio, new Date('2026-11-03T10:00:00Z'), null)).toBe(0)
+    expect(formatearClp(50000).replace(/\s/g, ' ')).toMatch(/\$\s?50\.000/)
+  })
+})
