+          <dd>{formatearRangoFechas(reserva.inicio, reserva.fin)}</dd>
+        </div>
+        <div>
+          <dt>Total</dt>
+          <dd className={estilo.precio}>{formatearClp(reserva.precioTotal)}</dd>
