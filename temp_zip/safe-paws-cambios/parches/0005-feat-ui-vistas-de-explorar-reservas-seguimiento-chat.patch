@@ -0,0 +1,73 @@
+import { useCallback } from 'react'
+import { Link } from 'react-router-dom'
+import Button from '@/components/ui/Button'
+import EstadoVista from '@/components/ui/EstadoVista'
+import { useAuth } from '@/hooks/useAuth'
+import { useCarga } from '@/hooks/useCarga'
+import { listarConversaciones, obtenerPerfilesPublicos, otroParticipante } from '@/services/supabase/chat'
+import type { Conversacion, PerfilPublico } from '@/types/dominio'
+import { clases } from '@/utils/clases'
+import Avatar from './Avatar'
+import { nombreCompleto } from './logicaChat'
+import { formatearActividad } from './tiempo'
+import estilo from './MensajesPage.module.css'
+
+interface DatosBandeja {
+  conversaciones: Conversacion[]
+  perfiles: Map<string, PerfilPublico>
+}
+
+export default function MensajesPage() {
+  const { usuario } = useAuth()
+  const miId = usuario?.id ?? ''
+
+  const cargar = useCallback(async (): Promise<DatosBandeja> => {
+    const conversaciones = await listarConversaciones()
+    const perfiles = await obtenerPerfilesPublicos(conversaciones.map((c) => otroParticipante(c, miId)))
+    return { conversaciones, perfiles }
+  }, [miId])
+
+  const { datos, cargando, error, recargar } = useCarga(cargar)
+  const conversaciones = datos?.conversaciones ?? []
+
+  return (
+    <div className={clases('contenedor', estilo.pagina)}>
+      <header className={estilo.encabezado}>
+        <h1 className={estilo.titulo}>Mensajes</h1>
+        <p className={estilo.subtitulo}>Coordina cuidados y resuelve dudas con dueños y cuidadores.</p>
+      </header>
+
+      <EstadoVista
+        cargando={cargando}
+        error={error}
+        alReintentar={recargar}
+        etiquetaCarga="Cargando conversaciones…"
+        vacio={conversaciones.length === 0}
+        mensajeVacio="Aún no tienes conversaciones"
+        accionVacio={<Button enlace="/explorar">Buscar cuidadores</Button>}
+      >
+        <ul className={estilo.lista}>
+          {conversaciones.map((conversacion) => {
+            const otroId = otroParticipante(conversacion, miId)
+            const perfil = datos?.perfiles.get(otroId)
+            const actividad = formatearActividad(conversacion.ultimoMensajeEn)
+            return (
+              <li key={conversacion.id}>
+                <Link to={`/mensajes/${conversacion.id}`} className={estilo.item}>
+                  <Avatar perfil={perfil} />
+                  <span className={estilo.cuerpo}>
+                    <span className={estilo.nombre}>{nombreCompleto(perfil)}</span>
+                    <span className={estilo.detalle}>
+                      {perfil?.comuna ? perfil.comuna : 'Conversación'}
+                    </span>
+                  </span>
+                  <span className={estilo.hora}>{actividad || 'Sin mensajes'}</span>
+                </Link>
+              </li>
+            )
+          })}
+        </ul>
+      </EstadoVista>
+    </div>
+  )
+}
diff --git a/src/pages/mensajes/logicaChat.test.ts b/src/pages/mensajes/logicaChat.test.ts
new file mode 100644
index 0000000..2fd9b47
--- /dev/null
+++ b/src/pages/mensajes/logicaChat.test.ts
@@ -0,0 +1,44 @@
+import { describe, expect, it } from 'vitest'
+import type { Mensaje } from '@/types/dominio'
+import { agregarMensaje, iniciales, nombreCompleto, ultimoLeidoPropio } from './logicaChat'
+
+function mensaje(id: string, autorId: string, creadoEn: string, leidoEn: string | null = null): Mensaje {
+  return { id, conversacionId: 'c1', autorId, texto: id, fotoUrl: null, leidoEn, creadoEn }
+}
+
+describe('agregarMensaje', () => {
+  it('no duplica por id y actualiza el existente', () => {
+    const lista = [mensaje('a', 'yo', '2026-10-20T10:00:00Z')]
+    const resultado = agregarMensaje(lista, { ...lista[0], leidoEn: '2026-10-20T10:01:00Z' })
+    expect(resultado).toHaveLength(1)
+    expect(resultado[0].leidoEn).toBe('2026-10-20T10:01:00Z')
+  })
+
+  it('agrega al final y reordena si llega fuera de orden', () => {
+    const lista = [mensaje('a', 'yo', '2026-10-20T10:00:00Z'), mensaje('c', 'yo', '2026-10-20T10:05:00Z')]
+    expect(agregarMensaje(lista, mensaje('b', 'otro', '2026-10-20T10:02:00Z')).map((m) => m.id)).toEqual(['a', 'b', 'c'])
+    expect(agregarMensaje(lista, mensaje('d', 'otro', '2026-10-20T10:09:00Z')).map((m) => m.id)).toEqual(['a', 'c', 'd'])
+  })
+})
+
+describe('ultimoLeidoPropio', () => {
+  it('devuelve el último mensaje propio leído', () => {
+    const lista = [
+      mensaje('a', 'yo', '1', 'x'),
+      mensaje('b', 'yo', '2', 'x'),
+      mensaje('c', 'otro', '3', 'x'),
+      mensaje('d', 'yo', '4'),
+    ]
+    expect(ultimoLeidoPropio(lista, 'yo')).toBe('b')
+    expect(ultimoLeidoPropio([mensaje('d', 'yo', '4')], 'yo')).toBeNull()
+  })
+})
+
+describe('nombres', () => {
+  it('arma nombre e iniciales con respaldo', () => {
+    expect(nombreCompleto({ nombre: 'Ana', apellido: 'Rojas' })).toBe('Ana Rojas')
+    expect(nombreCompleto(null)).toBe('Usuario de Safe Paws')
+    expect(iniciales({ nombre: 'ana', apellido: 'rojas' })).toBe('AR')
+    expect(iniciales({ nombre: '', apellido: '' })).toBe('?')
+  })
+})
