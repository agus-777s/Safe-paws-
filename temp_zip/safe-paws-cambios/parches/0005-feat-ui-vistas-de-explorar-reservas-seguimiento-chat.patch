+  align-items: center;
+  gap: var(--espaciado-3);
+  padding: var(--espaciado-3);
+  border: 1px solid var(--color-linea-suave);
+  border-radius: var(--radio-mediano);
+  background-color: var(--color-superficie);
+}
+
+.recordatorioVencido {
+  border-color: rgb(217 45 32 / 0.35);
+  background-color: rgb(217 45 32 / 0.05);
+}
+
+.recordatorioHecho .recordatorioTitulo {
+  text-decoration: line-through;
