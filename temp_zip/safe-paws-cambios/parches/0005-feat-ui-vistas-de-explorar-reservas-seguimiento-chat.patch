+import { describe, expect, it } from 'vitest'
+import { alternar, formularioDesdePerfil, leerPrecio, validarFormularioPerfil } from './formularioPerfil'
+import type { PerfilCuidador } from '@/types/dominio'
+
+const base = () => ({
+  ...formularioDesdePerfil(null),
+  servicios: ['paseo' as const],
+  precios: { paseo: '12.000', hospedaje: '', guarderia: '', visita: '' },
+  comuna: 'Ñuñoa',
+})
+
+describe('formulario de perfil de cuidador', () => {
+  it('lee precios enteros en CLP', () => {
+    expect(leerPrecio('12.000')).toBe(12000)
+    expect(leerPrecio('$ 8000')).toBe(8000)
+    expect(leerPrecio('0')).toBeNull()
+    expect(leerPrecio('12,5')).toBeNull()
+    expect(leerPrecio('')).toBeNull()
+  })
+
+  it('valida y arma los datos para guardar', () => {
+    const resultado = validarFormularioPerfil({ ...base(), dias: [5, 1, 3] })
+    expect(resultado.ok).toBe(true)
+    if (!resultado.ok) return
+    expect(resultado.datos.precios).toEqual({ paseo: 12000, hospedaje: null, guarderia: null, visita: null })
+    expect(resultado.datos.dias).toEqual([1, 3, 5])
+  })
+
+  it('exige al menos un servicio', () => {
+    const resultado = validarFormularioPerfil({ ...base(), servicios: [] })
+    expect(resultado.ok).toBe(false)
+    if (resultado.ok) return
+    expect(resultado.errores.servicios).toBeDefined()
+  })
+
+  it('exige precio para cada servicio elegido e ignora los no elegidos', () => {
+    const resultado = validarFormularioPerfil({ ...base(), servicios: ['paseo', 'hospedaje'] })
+    expect(resultado.ok).toBe(false)
+    if (resultado.ok) return
+    expect(resultado.errores.precio_hospedaje).toBeDefined()
+    expect(resultado.errores.precio_paseo).toBeUndefined()
+  })
+
+  it('exige hora de término posterior a la de inicio', () => {
+    const resultado = validarFormularioPerfil({ ...base(), horaInicio: '18:00', horaFin: '09:00' })
+    expect(resultado.ok).toBe(false)
+    if (resultado.ok) return
+    expect(resultado.errores.horario).toMatch(/posterior/)
+  })
+
+  it('carga un perfil existente', () => {
+    const perfil: PerfilCuidador = {
+      id: 'c',
+      bio: 'Hola',
+      servicios: ['visita'],
+      precios: { paseo: null, hospedaje: null, guarderia: null, visita: 9000 },
+      comuna: 'Macul',
+      latitud: -33.5,
+      longitud: -70.6,
+      radioKm: 10,
+      dias: [6],
+      horaInicio: '09:00',
+      horaFin: '13:00',
+      verificado: false,
+      calificacion: 0,
+      totalResenas: 0,
+      activo: false,
+    }
+    const formulario = formularioDesdePerfil(perfil)
+    expect(formulario.precios.visita).toBe('9000')
+    expect(formulario.precios.paseo).toBe('')
+    expect(formulario.activo).toBe(false)
+  })
+
+  it('alterna valores en una lista', () => {
+    expect(alternar([1, 2], 2)).toEqual([1])
+    expect(alternar([1], 3)).toEqual([1, 3])
+  })
+})
diff --git a/src/pages/panel/formularioPerfil.ts b/src/pages/panel/formularioPerfil.ts
new file mode 100644
index 0000000..66ba64f
--- /dev/null
+++ b/src/pages/panel/formularioPerfil.ts
@@ -0,0 +1,115 @@
+import type { DatosPerfilCuidador } from '@/services/supabase/cuidadores'
+import type { PerfilCuidador, Servicio } from '@/types/dominio'
+
+export interface FormularioPerfil {
+  bio: string
+  servicios: Servicio[]
+  /** Precios como texto mientras se editan. */
+  precios: Record<Servicio, string>
+  comuna: string
+  latitud: number | null
+  longitud: number | null
+  radioKm: number
+  dias: number[]
+  horaInicio: string
+  horaFin: string
+  activo: boolean
+}
+
+export type ErroresPerfil = Partial<Record<'servicios' | 'horario' | 'comuna' | `precio_${Servicio}`, string>>
+
+const PRECIOS_VACIOS: Record<Servicio, string> = { paseo: '', hospedaje: '', guarderia: '', visita: '' }
+
+export function formularioDesdePerfil(perfil: PerfilCuidador | null, respaldo?: Partial<FormularioPerfil>): FormularioPerfil {
+  if (!perfil) {
+    return {
+      bio: '',
+      servicios: [],
+      precios: { ...PRECIOS_VACIOS },
+      comuna: '',
+      latitud: null,
+      longitud: null,
+      radioKm: 5,
+      dias: [1, 2, 3, 4, 5],
+      horaInicio: '08:00',
+      horaFin: '19:00',
+      activo: true,
+      ...respaldo,
+    }
+  }
+  const precios = { ...PRECIOS_VACIOS }
+  for (const clave of Object.keys(precios) as Servicio[]) {
+    const valor = perfil.precios[clave]
+    precios[clave] = valor == null ? '' : String(valor)
+  }
+  return {
+    bio: perfil.bio,
+    servicios: [...perfil.servicios],
+    precios,
+    comuna: perfil.comuna,
+    latitud: perfil.latitud,
+    longitud: perfil.longitud,
+    radioKm: perfil.radioKm,
+    dias: [...perfil.dias],
+    horaInicio: perfil.horaInicio,
+    horaFin: perfil.horaFin,
+    activo: perfil.activo,
+  }
+}
+
+/** Precio entero en CLP (acepta "12.000", "$ 12000"). Null si no es válido. */
+export function leerPrecio(texto: string): number | null {
+  const limpio = texto.replace(/[$\s.]/g, '')
+  if (!/^\d+$/.test(limpio)) return null
+  const valor = Number(limpio)
+  return valor > 0 && Number.isSafeInteger(valor) ? valor : null
+}
+
+function minutos(hora: string): number | null {
+  const coincidencia = /^(\d{2}):(\d{2})/.exec(hora)
+  if (!coincidencia) return null
+  return Number(coincidencia[1]) * 60 + Number(coincidencia[2])
+}
+
+export function validarFormularioPerfil(
+  formulario: FormularioPerfil,
+): { ok: true; datos: DatosPerfilCuidador } | { ok: false; errores: ErroresPerfil } {
+  const errores: ErroresPerfil = {}
+  if (formulario.servicios.length === 0) errores.servicios = 'Elige al menos un servicio.'
+
+  const precios: Record<Servicio, number | null> = { paseo: null, hospedaje: null, guarderia: null, visita: null }
+  for (const servicio of formulario.servicios) {
+    const precio = leerPrecio(formulario.precios[servicio])
+    if (precio == null) errores[`precio_${servicio}`] = 'Ingresa un precio en pesos (número entero mayor a 0).'
+    precios[servicio] = precio
+  }
+
+  const inicio = minutos(formulario.horaInicio)
+  const fin = minutos(formulario.horaFin)
+  if (inicio == null || fin == null) errores.horario = 'Indica la hora de inicio y de término.'
+  else if (fin <= inicio) errores.horario = 'La hora de término debe ser posterior a la de inicio.'
+
+  if (!formulario.comuna.trim()) errores.comuna = 'Indica tu comuna o elige un punto en el mapa.'
+
+  if (Object.keys(errores).length > 0) return { ok: false, errores }
+  return {
+    ok: true,
+    datos: {
+      bio: formulario.bio,
+      servicios: formulario.servicios,
+      precios,
+      comuna: formulario.comuna,
+      latitud: formulario.latitud,
+      longitud: formulario.longitud,
+      radioKm: formulario.radioKm,
+      dias: [...formulario.dias].sort((a, b) => a - b),
+      horaInicio: formulario.horaInicio,
+      horaFin: formulario.horaFin,
+      activo: formulario.activo,
+    },
+  }
+}
+
+export function alternar<T>(lista: T[], valor: T): T[] {
+  return lista.includes(valor) ? lista.filter((x) => x !== valor) : [...lista, valor]
+}
