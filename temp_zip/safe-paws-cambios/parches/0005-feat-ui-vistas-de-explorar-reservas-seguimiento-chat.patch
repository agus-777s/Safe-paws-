+  flex-direction: column;
+  cursor: pointer;
+}
+
+.recordatorioTitulo {
+  font-weight: 700;
+  overflow-wrap: anywhere;
+}
+
+.recordatorioMeta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--espaciado-2);
+  font-size: 0.85rem;
+  color: var(--color-texto-suave);
+}
+
+.insignia {
+  padding: 1px 8px;
+  border-radius: 999px;
+  background-color: var(--color-error);
+  color: #fff;
+  font-size: 0.72rem;
+  font-weight: 800;
+}
+
+.quitar {
+  flex-shrink: 0;
+  width: 32px;
+  height: 32px;
+  border: none;
+  border-radius: 50%;
+  background-color: transparent;
+  color: var(--color-texto-suave);
+  font-size: 1.2rem;
+  cursor: pointer;
+}
+
+.quitar:hover:not(:disabled) {
+  background-color: var(--color-superficie-baja);
+  color: var(--color-error);
+}
+
+@media (max-width: 768px) {
+  .pagina {
+    padding-block: var(--espaciado-5);
+  }
+
+  .ficha {
+    grid-template-columns: 1fr;
+    padding: var(--espaciado-4);
+  }
+
+  .nombre {
+    font-size: 1.6rem;
+  }
+
+  .seccionRecordatorios {
+    padding: var(--espaciado-4);
+  }
+
+  .formRecordatorio {
+    grid-template-columns: 1fr 1fr;
+  }
+
+  .formRecordatorio > :first-child {
+    grid-column: 1 / -1;
+  }
+
+  .botonAgregar {
+    grid-column: 1 / -1;
+    margin-top: 0;
+  }
+}
