@@ -0,0 +1,115 @@
+.pagina {
+  padding-block: var(--espaciado-6) var(--espaciado-7);
+}
+
+.encabezado {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: var(--espaciado-3);
+  margin-bottom: var(--espaciado-5);
+}
+
+.titulo {
+  font-size: 2rem;
+  font-weight: 800;
+  color: var(--color-bosque);
+}
+
+.subtitulo {
+  margin-top: var(--espaciado-1);
+  color: var(--color-texto-suave);
+}
+
+.grilla {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
+  gap: var(--espaciado-4);
+}
+
+.tarjeta {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  background-color: var(--color-superficie);
+  border: 1px solid var(--color-linea-suave);
+  border-radius: var(--radio-grande);
+  box-shadow: var(--sombra-suave);
+  overflow: hidden;
+  color: inherit;
+  text-decoration: none;
+  transition:
+    transform 0.15s ease,
+    box-shadow 0.15s ease;
+}
+
+.tarjeta:hover {
+  transform: translateY(-2px);
+  box-shadow: 0 6px 20px rgb(0 0 0 / 0.08);
+}
+
+.tarjeta:focus-visible {
+  outline: 3px solid var(--color-bosque-claro);
+  outline-offset: 2px;
+}
+
+.foto {
+  aspect-ratio: 4 / 3;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background-color: var(--color-beige);
+}
+
+.foto img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+
+.emoji {
+  font-size: 3.5rem;
+}
+
+.info {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: var(--espaciado-3) var(--espaciado-4) var(--espaciado-4);
+}
+
+.nombre {
+  font-size: 1.1rem;
+  font-weight: 800;
+  color: var(--color-bosque);
+}
+
+.detalle {
+  font-size: 0.88rem;
+  color: var(--color-texto-suave);
+}
+
+@media (max-width: 768px) {
+  .pagina {
+    padding-block: var(--espaciado-5);
+  }
+
+  .titulo {
+    font-size: 1.6rem;
+  }
+
+  .grilla {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: var(--espaciado-3);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .tarjeta {
+    transition: none;
+  }
+}
