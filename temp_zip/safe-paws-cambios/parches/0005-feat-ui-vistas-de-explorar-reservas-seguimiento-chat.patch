+}
+
+.bloque {
+  display: flex;
+  flex-direction: column;
+  gap: var(--espaciado-1);
+}
+
+.bloqueTitulo {
+  font-size: 1rem;
+  font-weight: 800;
+  color: var(--color-bosque);
+}
+
+.bloqueTexto {
+  white-space: pre-wrap;
